# ============================================================
# WORKER config - read by worker/index.ts (npm run worker / start-worker.bat).
# This is what you set up on the PC with the GPU + ComfyUI.
# ============================================================

# CLOUD_API_URL: your deployed Vercel app's URL (e.g. https://myaiimagegen.vercel.app or a
# custom domain). The worker polls OUT to this - no inbound port/tunnel needed on this PC.
CLOUD_API_URL="https://your-app.vercel.app"

# WORKER_TOKEN: must exactly match the WORKER_TOKEN set in the Vercel project's environment
# variables - this is how the worker authenticates to /api/worker/* routes. Generate any long
# random string; it's a machine credential, not something you type in day-to-day.
WORKER_TOKEN="generate-a-long-random-string"

# COMFYUI_URL: local ComfyUI instance the worker drives directly.
COMFYUI_URL="http://127.0.0.1:8188"

# BLOB_READ_WRITE_TOKEN: from the Vercel Blob store connected to this project (Storage tab in
# the Vercel dashboard) - the worker uploads generated media here directly.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ============================================================
# CLOUD config - set these in the Vercel project's Environment Variables (dashboard or
# `vercel env add`), NOT needed in this local .env unless you're running `npm run
# migrate:postgres` (needs DATABASE_URL) or the legacy local-only server (see below).
# ============================================================

# DATABASE_URL: from the Postgres (Neon) integration connected to this Vercel project.
# DATABASE_URL="postgres://..."

# SITE_PASSWORD: the shared password gating the public dashboard (see LoginGate.tsx).
# SITE_PASSWORD="pick-a-real-password"

# SESSION_SECRET: signs the login session cookie - any long random string.
# SESSION_SECRET="generate-a-long-random-string"

# ENCRYPTION_SECRET: master key used for AES-256 vault display fields (prompt ciphertext
# shown in the gallery's metadata inspector). Used by both the cloud API (encrypting on job
# creation) and the legacy local server below.
ENCRYPTION_SECRET="master_encrypted_key_rtx3060ti_2026"

# ============================================================
# LEGACY: only needed if you still run the old local-only server (`npm run dev`, server.ts)
# instead of the Vercel + worker split above. Superseded for remote access, kept for
# reference/rollback.
# ============================================================

# PORT: Port the legacy local Express server listens on
PORT=3000

# GATEWAY_AUTH_TOKEN: Secret Bearer token for the legacy local server's AI Studio & external
# client authorization
GATEWAY_AUTH_TOKEN="sec_rtx3060ti_gateway_key_9988"

# CLOUDFLARE_TUNNEL_NAME / CLOUDFLARE_TUNNEL_HOSTNAME: optional stable public URL for the
# legacy local server - see "Stable public URL" in README.md. Leave both unset for the
# zero-config random trycloudflare.com default.
# CLOUDFLARE_TUNNEL_NAME="myaiimagegen"
# CLOUDFLARE_TUNNEL_HOSTNAME="imagegen.savestate.co.za"
