# PORT: Port the gateway's Express server listens on
PORT=3000

# COMFYUI_URL: URL of local ComfyUI or Cloudflare Tunnel (e.g. http://127.0.0.1:8188 or https://my-tunnel.trycloudflare.com)
COMFYUI_URL="http://127.0.0.1:8188"

# GATEWAY_AUTH_TOKEN: Secret Bearer token for AI Studio & external client authorization
GATEWAY_AUTH_TOKEN="sec_rtx3060ti_gateway_key_9988"

# ENCRYPTION_SECRET: Master key used for AES-256 asset & credential encryption
ENCRYPTION_SECRET="master_encrypted_key_rtx3060ti_2026"

# CLOUDFLARE_TUNNEL_NAME / CLOUDFLARE_TUNNEL_HOSTNAME: optional - set BOTH to use a stable,
# never-changing public URL on a domain you already own in Cloudflare, instead of the default
# random trycloudflare.com URL that changes every restart. One-time setup required first -
# see "Stable public URL" in README.md. Leave both unset for the zero-config default.
# CLOUDFLARE_TUNNEL_NAME="myaiimagegen"
# CLOUDFLARE_TUNNEL_HOSTNAME="imagegen.savestate.co.za"
